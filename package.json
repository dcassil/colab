{
  "name": "colab-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Universal, drop-in real-time collaboration/presence for any web app (monorepo root).",
  "license": "MIT",
  "author": "Daniel Cassil <me@danielcassil.com>",
  "packageManager": "pnpm@10.33.1",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "typecheck": "tsc -b",
    "build": "pnpm -r --filter \"./packages/*\" build",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "depcruise": "pnpm -r depcruise"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.1.0",
    "eslint-plugin-import": "^2.32.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ]
  }
}
