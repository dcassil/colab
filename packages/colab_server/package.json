{
  "name": "colab-server",
  "version": "0.1.2",
  "type": "module",
  "description": "Socket.IO relay server for colab collaboration sessions.",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "colab-server": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/bin.js"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dcassil/colab.git",
    "directory": "packages/colab_server"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "colab-protocol": "0.1.2",
    "socket.io": "4.8.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "socket.io-client": "^4.8.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  }
}
